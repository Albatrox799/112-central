## Devuelve todas las llamadas nuevas con su conversación completa.
static func construir() -> Array:
	var lista: Array = []
	for d in SIMPLES:
		if d.get("falsa", false):
			lista.append(_falsa(d))
		else:
			lista.append(_real(d))
	for d in ESPECIALES:
		lista.append(d)
	return lista


